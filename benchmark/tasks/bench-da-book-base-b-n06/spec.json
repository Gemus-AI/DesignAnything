    {
      "id": "natural-species-features",
      "requirementId": "R-natural-species-features",
      "method": "visual",
      "targetSlots": [
        "front-cover",
        "species-robin",
        "species-daisy",
        "species-ladybird",
        "index",
        "record-blank"
      ],
      "criteria": "Assess each depicted supplied species against its relevant features. Adult robin: orange-red face and breast, brown back, pale belly. Adult blue tit: blue cap and wings, white face with dark eye stripe, greenish back, yellow underparts and fine short beak; its overview shows it resting on a twig. Daisy: white rays and yellow centre on a slender stalk connected to a rooted low rosette of spoon-shaped leaves. Clover: an intact leaf normally has three leaflets joined at one point, beside a rounded white or pinkish head; pale markings may vary. Adult ladybird: red wing cases with three black spots on each side and one shared near the front, plus black-and-white thorax markings. Snail: mottled coiled shell attached to its body and two long upper tentacles; lower tentacles can be small or hidden. Detail crops may isolate the named feature, and natural occlusion is allowed; the ladybird overview must still communicate the seven-spot arrangement. Unrelated plants in reference backgrounds must not become daisy anatomy.",
      "inputFiles": [
        "benchmarks/design-anything/v0.6/assets/bench-da-book-base-b-n06/01-client-facts.en.md",
