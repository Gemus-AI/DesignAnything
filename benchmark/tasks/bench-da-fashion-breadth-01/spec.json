    {
      "id": "flat-views-and-finished-measurements",
      "requirementId": "R-flat-views-and-finished-measurements",
      "method": "visual",
      "targetSlots": [
        "front-material-board",
        "back-flat-board"
      ],
      "criteria": "Both boards depict complete front or rear views, respectively, of the short-sleeved top and shorts for A and B. Read the front measurements as full circumferences: A chest 1040–1120 mm and hip 1100–1180 mm; B chest 1240–1320 mm and hip 1220–1300 mm, inclusive. Each size has a designer-selected back length and inseam in mm, repeated without contradiction on the rear board. Rear seams and any rear pockets are identifiable. Missing views, out-of-range values, ambiguous half-circumference notation or inconsistent dimensions fail.",
      "inputFiles": [
        "benchmarks/design-anything/v0.6/scenarios/bench-da-fashion-breadth-01.json",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/01-client-facts.en.md",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/02-delivery-catalog.en.md",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/bodies-and-use.en.md",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/materials.en.md"
      ],
      "visualScope": "set"
    },
    {
      "id": "waist-dressing-and-adjustment",
      "requirementId": "R-waist-dressing-and-adjustment",
      "method": "visual",
      "targetSlots": [
        "front-material-board",
        "construction-details"
      ],
      "criteria": "Read matching relaxed and comfortably extended full waist targets on both boards for each size. A must have relaxed waist <800 mm and extension ≥800 mm; B must have relaxed waist <1000 mm and extension ≥1000 mm. The details explain entry and removal for each garment and depict a compatible waist adjustment. Pull-on dressing and alternatives to elastic are allowed. If T1 is selected, its width is recorded in mm and its fabric enclosure is visible; absent measurements, conflicting targets or unexplained construction fail.",
      "inputFiles": [
        "benchmarks/design-anything/v0.6/scenarios/bench-da-fashion-breadth-01.json",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/01-client-facts.en.md",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/02-delivery-catalog.en.md",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/bodies-and-use.en.md",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/materials.en.md"
      ],
      "visualScope": "set"
    },
    {
      "id": "usable-pocket-and-placement",
      "requirementId": "R-usable-pocket-and-placement",
      "method": "visual",
      "targetSlots": [
        "construction-details",
        "front-material-board",
        "back-flat-board",
        "body-a-standing",
        "body-b-seated",
        "body-b-side-lying"
      ],
      "criteria": "For each size, identify a functional garment pocket with separately readable opening and usable internal depth dimensions of at least 110 mm, suitable for the folded 100 × 100 mm cloth. Its position is dimensioned for A and B independently. Compare visible pocket locations, openings and construction across the flats and worn views. Different size-specific offsets and natural occlusion are allowed; absent dimensions, an undersized pocket or contradictory visible placement fail. The cloth need not be depicted.",
      "inputFiles": [
        "benchmarks/design-anything/v0.6/scenarios/bench-da-fashion-breadth-01.json",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/01-client-facts.en.md",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/02-delivery-catalog.en.md",
