    {
      "id": "shell-specification-and-color-system",
      "requirementId": "R-shell-specification-and-color-system",
      "method": "visual",
      "targetSlots": [
        "front-material-board",
        "back-flat-board",
        "construction-details",
        "body-a-standing",
        "body-b-seated",
        "body-b-side-lying"
      ],
      "criteria": "The front specification selects exactly one common shell for top and shorts: F1 means 100% cotton, plain weave, 125 g/m²; F2 means 95% cotton / 5% elastane, single jersey, 165 g/m². Its final key maps two or three named colors, each with six hexadecimal digits, to garment areas. All views follow those assignments across A and B; monochrome technical drawings explicitly link to the named key. Lighting and shading may alter apparent color. Mixed shell choices, incorrect specification fields, missing codes or inconsistent area assignments fail.",
      "inputFiles": [
        "benchmarks/design-anything/v0.6/scenarios/bench-da-fashion-breadth-01.json",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/01-client-facts.en.md",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/02-delivery-catalog.en.md",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/bodies-and-use.en.md",
