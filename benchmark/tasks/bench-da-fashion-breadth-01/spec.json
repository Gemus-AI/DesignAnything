      "requirementId": "R-skin-contact-label-and-fittings",
      "method": "visual",
      "targetSlots": [
        "construction-details",
        "body-b-side-lying"
      ],
      "criteria": "Construction views reveal the internal seam treatment, fabric surface against the waist and attachment of an inside identification label. The label displays the brand on its first line and descriptor on its second, both readable. Any hard components shown in the construction or lying view remain outside the outer shoulder and outer hip support-contact regions. A design without hard fittings passes that portion; missing contact details, an exterior-only label or a fitting at a prohibited contact region fails.",
      "inputFiles": [
        "benchmarks/design-anything/v0.6/scenarios/bench-da-fashion-breadth-01.json",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/01-client-facts.en.md",
