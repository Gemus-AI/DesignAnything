      "requirementId": "R-wearing-poses-coverage-and-adaptation",
      "method": "visual",
      "targetSlots": [
        "body-a-standing",
        "body-b-seated",
        "body-b-side-lying"
      ],
      "criteria": "The home scenes depict an adult A upright with relaxed arms, adult B seated with bent knees and the same B lying on either side with knees gently bent. Each wears the complete specified short-sleeved top and shorts; the top covers the waist and shorts cover the upper thighs in that pose. Visible neckline, sleeves, openings and seams agree with the technical views. Proportions and pockets follow the corresponding size adaptation, with folds responding to posture and the chosen fabric. Simple home furniture and either lying direction are allowed; wrong poses, exposed required coverage areas or incompatible garment features fail.",
      "inputFiles": [
        "benchmarks/design-anything/v0.6/scenarios/bench-da-fashion-breadth-01.json",
        "benchmarks/design-anything/v0.6/assets/bench-da-fashion-breadth-01/01-client-facts.en.md",
